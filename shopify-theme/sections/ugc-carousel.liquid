{% comment %}
  Section: ugc-carousel
  Ported from: Home.tsx §14 UGC CAROUSEL
  Note: Replace block video URLs with real UGC video handles from Shopify Files
{% endcomment %}
<section class="ugc-carousel" aria-label="Customer videos">
  <div class="container">
    <h2 class="section-title">{{ section.settings.heading | default: 'See It In Action' | escape }}</h2>
    <div class="ugc-carousel__track" role="list">
      {%- for block in section.blocks -%}
        {%- if block.type == 'video' -%}
          <div class="ugc-carousel__item" role="listitem" {{ block.shopify_attributes }}>
            {%- if block.settings.thumbnail != blank -%}
              <img src="{{ block.settings.thumbnail | image_url: width: 300 }}" alt="{{ block.settings.alt | escape }}" width="300" loading="lazy" class="ugc-carousel__thumbnail">
            {%- endif -%}
            <button class="ugc-carousel__play" aria-label="Play video" data-video="{{ block.settings.video_url | escape }}">
              <svg viewBox="0 0 24 24" fill="currentColor" width="40" height="40"><path d="M8 5v14l11-7z"/></svg>
            </button>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "UGC Carousel",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "See It In Action" }
  ],
  "blocks": [
    {
      "type": "video",
      "name": "Video",
      "settings": [
        { "type": "image_picker", "id": "thumbnail", "label": "Thumbnail image" },
        { "type": "text", "id": "alt", "label": "Alt text" },
        { "type": "url", "id": "video_url", "label": "Video URL" }
      ]
    }
  ],
  "presets": [{ "name": "UGC Carousel" }]
}
{% endschema %}

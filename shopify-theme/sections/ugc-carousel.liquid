<section class="ugc-carousel section-espresso" id="ugc" aria-label="Customer videos">
  <div class="container">
    <div class="luma-section-kicker luma-section-kicker--dark">Real routines</div>
    <h2 class="section-title">{{ section.settings.heading | default: 'See what the community is saying.' | escape }}</h2>
    <div class="ugc-carousel__track" role="list">
      <div class="ugc-carousel__item" role="listitem"><img src="https://d2xsxph8kpxj0f.cloudfront.net/310519663633783733/AnQGopwkGMamh4C9LsYVXo/thumb_energy-BU5nytyV5C6nddBCV93s23.webp" alt="Luma Energy customer video" width="300" height="533" loading="lazy" class="ugc-carousel__thumbnail"><span class="ugc-carousel__play">&#9658;</span></div>
      <div class="ugc-carousel__item" role="listitem"><img src="https://d2xsxph8kpxj0f.cloudfront.net/310519663633783733/AnQGopwkGMamh4C9LsYVXo/thumb_older_male-BqsWzS3XoAKMWarYRyTefB.webp" alt="Luma customer video" width="300" height="533" loading="lazy" class="ugc-carousel__thumbnail"><span class="ugc-carousel__play">&#9658;</span></div>
      <div class="ugc-carousel__item" role="listitem"><img src="https://d2xsxph8kpxj0f.cloudfront.net/310519663633783733/AnQGopwkGMamh4C9LsYVXo/thumb_sleep-8FLZ7pbsugrQz3RE5hzykg.webp" alt="Luma Sleep customer video" width="300" height="533" loading="lazy" class="ugc-carousel__thumbnail"><span class="ugc-carousel__play">&#9658;</span></div>
      <div class="ugc-carousel__item" role="listitem"><img src="https://d2xsxph8kpxj0f.cloudfront.net/310519663633783733/AnQGopwkGMamh4C9LsYVXo/thumb_glow-hUmz5zqBmQei2iszVAQKin.webp" alt="Luma Glow customer video" width="300" height="533" loading="lazy" class="ugc-carousel__thumbnail"><span class="ugc-carousel__play">&#9658;</span></div>
      <div class="ugc-carousel__item" role="listitem"><img src="https://d2xsxph8kpxj0f.cloudfront.net/310519663633783733/AnQGopwkGMamh4C9LsYVXo/thumb_gut-WBWzhM9Wa3FaiF8puE958A.webp" alt="Luma Gut customer video" width="300" height="533" loading="lazy" class="ugc-carousel__thumbnail"><span class="ugc-carousel__play">&#9658;</span></div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "UGC Carousel",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "See what the community is saying." }
  ],
  "presets": [{ "name": "UGC Carousel" }]
}
{% endschema %}

{% comment %}
  Section: trust-bar
  Ported from: Home.tsx §5 TRUST BAR
{% endcomment %}
<section class="trust-bar" aria-label="Trust signals">
  <div class="container trust-bar__grid">
    {%- for block in section.blocks -%}
      {%- if block.type == 'item' -%}
        <div class="trust-bar__item" {{ block.shopify_attributes }}>
          <span class="trust-bar__icon" aria-hidden="true">{{ block.settings.emoji }}</span>
          <div>
            <strong class="trust-bar__label">{{ block.settings.label | escape }}</strong>
            <p class="trust-bar__sub">{{ block.settings.sublabel | escape }}</p>
          </div>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>
{% schema %}
{
  "name": "Trust Bar",
  "tag": "section",
  "settings": [],
  "blocks": [
    {
      "type": "item",
      "name": "Trust Item",
      "settings": [
        { "type": "text", "id": "emoji", "label": "Emoji icon", "default": "✓" },
        { "type": "text", "id": "label", "label": "Label" },
        { "type": "text", "id": "sublabel", "label": "Sub-label" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust Bar",
      "blocks": [
        { "type": "item", "settings": { "emoji": "✓", "label": "Results in 30 Days", "sublabel": "Or your money back" } },
        { "type": "item", "settings": { "emoji": "★", "label": "Tastes Amazing", "sublabel": "Real fruit flavors" } },
        { "type": "item", "settings": { "emoji": "🌿", "label": "Clean Ingredients", "sublabel": "No artificial anything" } },
        { "type": "item", "settings": { "emoji": "🧪", "label": "Third-Party Tested", "sublabel": "Every batch, every time" } }
      ]
    }
  ]
}
{% endschema %}

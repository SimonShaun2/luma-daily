{% comment %}
  Section: reviews
  Ported from: Home.tsx §12 REVIEWS
  Note: For live reviews, replace blocks with Okendo or Judge.me widget embed
{% endcomment %}
<section class="reviews" aria-label="Customer reviews">
  <div class="container">
    <div class="reviews__header">
      <h2 class="section-title">{{ section.settings.heading | default: 'Real Results, Real People' | escape }}</h2>
      <div class="reviews__summary">
        <span class="reviews__overall-stars" aria-label="{{ section.settings.overall_rating }} out of 5">★★★★★</span>
        <span class="reviews__overall-score">{{ section.settings.overall_rating | default: '4.9' }}</span>
        <span class="reviews__overall-count">{{ section.settings.review_count | default: '12,400+' }} reviews</span>
      </div>
    </div>
    <div class="reviews__grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'review' -%}
          <div class="review-card" {{ block.shopify_attributes }}>
            <div class="review-card__stars" aria-label="{{ block.settings.rating }} stars">★★★★★</div>
            <p class="review-card__body">{{ block.settings.body | escape }}</p>
            <div class="review-card__author">
              <strong>{{ block.settings.name | escape }}</strong>
              {%- if block.settings.verified -%}
                <span class="review-card__verified">✓ Verified Purchase</span>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Reviews",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Real Results, Real People" },
    { "type": "text", "id": "overall_rating", "label": "Overall rating", "default": "4.9" },
    { "type": "text", "id": "review_count", "label": "Review count", "default": "12,400+" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "range", "id": "rating", "label": "Rating", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "textarea", "id": "body", "label": "Review body" },
        { "type": "text", "id": "name", "label": "Reviewer name" },
        { "type": "checkbox", "id": "verified", "label": "Verified purchase", "default": true }
      ]
    }
  ],
  "presets": [{ "name": "Reviews" }]
}
{% endschema %}

{% comment %}
  Section: ingredients
  Ported from: Home.tsx §11 INGREDIENTS
{% endcomment %}
<section class="ingredients" aria-label="Key ingredients">
  <div class="container">
    <h2 class="section-title">{{ section.settings.heading | default: 'What Goes In — And Why' | escape }}</h2>
    <div class="ingredients__grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'ingredient' -%}
          <div class="ingredient-card" {{ block.shopify_attributes }}>
            <span class="ingredient-card__icon" aria-hidden="true">{{ block.settings.emoji }}</span>
            <h3 class="ingredient-card__name">{{ block.settings.name | escape }}</h3>
            <p class="ingredient-card__benefit">{{ block.settings.benefit | escape }}</p>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Ingredients",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "What Goes In — And Why" }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingredient",
      "settings": [
        { "type": "text", "id": "emoji", "label": "Emoji icon" },
        { "type": "text", "id": "name", "label": "Ingredient name" },
        { "type": "text", "id": "benefit", "label": "Benefit copy" }
      ]
    }
  ],
  "presets": [{ "name": "Ingredients" }]
}
{% endschema %}

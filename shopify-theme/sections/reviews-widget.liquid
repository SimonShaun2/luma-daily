<section class="reviews">
  <div class="container">
    <div class="reviews__header">
      <h2 class="section-title">Customer rituals</h2>
      <div class="reviews__summary"><span class="reviews__overall-stars">&#9733;&#9733;&#9733;&#9733;&#9733;</span><span class="reviews__overall-score">4.9</span><span class="reviews__overall-count">verified reviews</span></div>
    </div>
    <div class="review-card">
      <div class="review-card__stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
      <p class="review-card__body">"This made my wellness routine feel simple enough to keep."</p>
      <div class="review-card__author"><strong>Verified customer</strong><span class="review-card__verified">Review app placeholder</span></div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Reviews widget",
  "tag": "section",
  "settings": [],
  "presets": [{ "name": "Reviews widget" }]
}
{% endschema %}

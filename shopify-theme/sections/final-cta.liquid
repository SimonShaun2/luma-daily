<section class="final-cta" aria-label="Final call to action">
  <div class="container final-cta__inner">
    <div class="final-cta__content">
      <div class="luma-section-kicker luma-section-kicker--dark">Your daily ritual starts here</div>
      <h2>{{ section.settings.heading | escape }}</h2>
      <p>{{ section.settings.subhead | escape }}</p>
      <div class="hero__ctas">
        <a href="{{ section.settings.cta_url | default: '/pages/quiz' }}" class="btn btn--primary btn--lg">{{ section.settings.cta_label | escape }}</a>
        <a href="/collections/all" class="btn btn--ghost btn--lg">Shop formulas</a>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Final CTA",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Ready to start your ritual?" },
    { "type": "text", "id": "subhead", "label": "Subheadline", "default": "Take the quiz, choose a bundle, or shop every formula." },
    { "type": "text", "id": "cta_label", "label": "CTA label", "default": "Find My Ritual" },
    { "type": "url", "id": "cta_url", "label": "CTA URL" }
  ],
  "presets": [{ "name": "Final CTA" }]
}
{% endschema %}

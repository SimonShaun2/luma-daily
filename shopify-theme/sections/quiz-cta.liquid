<section class="quiz-cta" aria-label="Find My Ritual quiz">
  <div class="container quiz-cta__inner">
    <div class="quiz-cta__copy">
      <p class="luma-section-kicker luma-section-kicker--dark">Not sure where to start?</p>
      <h2>{{ section.settings.heading | escape }}</h2>
      <p>{{ section.settings.subhead | escape }}</p>
      <a href="{{ section.settings.quiz_url | default: '/pages/quiz' }}" class="btn btn--primary btn--lg">
        {{ section.settings.cta_label | escape }}
      </a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Quiz CTA",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Take 60 seconds. We'll build your ritual." },
    { "type": "text", "id": "subhead", "label": "Subheadline", "default": "Answer a few questions and get a daily routine matched to your goals." },
    { "type": "text", "id": "cta_label", "label": "CTA label", "default": "Find My Ritual" },
    { "type": "url", "id": "quiz_url", "label": "Quiz URL" }
  ],
  "presets": [{ "name": "Quiz CTA" }]
}
{% endschema %}

<section class="bundles section-amber" id="bundles" aria-label="Bundles">
  <div class="container">
    <div class="luma-section-kicker">Bundle and save</div>
    <h2 class="section-title">{{ section.settings.heading | default: 'Build your 30-day ritual.' | escape }}</h2>
    <p class="section-subhead">{{ section.settings.subhead | default: 'Bundle formulas by daypart and keep your ritual stocked.' | escape }}</p>

    <div class="bundles-carousel luma-card-grid luma-card-grid--two" role="list">
      {%- if section.settings.collection != blank and collections[section.settings.collection].products_count > 0 -%}
        {%- for product in collections[section.settings.collection].products -%}
          <div class="bundle-card" role="listitem">
            <a href="{{ product.url }}" class="bundle-card__image-link" tabindex="-1" aria-hidden="true">
              <img src="{{ product.featured_image | image_url: width: 640 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" class="bundle-card__image" width="640" height="480" loading="lazy">
            </a>
            <div class="bundle-card__body">
              <h3 class="bundle-card__title"><a href="{{ product.url }}">{{ product.title | escape }}</a></h3>
              <p class="bundle-card__tagline">{{ product.metafields.custom.tagline | default: product.description | strip_html | truncate: 120 }}</p>
              <div class="bundle-card__price"><span class="bundle-card__price-current">{{ product.price | money }}</span></div>
              <form action="/cart/add" method="post" class="bundle-card__atc-form">
                <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                <input type="hidden" name="quantity" value="1">
                <button type="submit" class="btn btn--primary btn--full">Buy this bundle</button>
              </form>
            </div>
          </div>
        {%- endfor -%}
      {%- else -%}
        {%- assign daily3 = all_products['the-daily-3-ritual'] -%}
        {%- assign full = all_products['the-full-ritual'] -%}
        {% render 'static-luma-bundle-card', product: daily3, handle: 'the-daily-3-ritual', title: 'The Daily 3 Bundle', subtitle: 'Energy + Calm + Sleep', image: 'https://takelumadaily.manus.space/manus-storage/bundle_daily3_noprice_7a4e331a.png', price: '$59', compare: '$104.97', savings: 'Save 44%' %}
        {% render 'static-luma-bundle-card', product: full, handle: 'the-full-ritual', title: 'The Full Ritual', subtitle: 'All 6 Formulas', image: 'https://takelumadaily.manus.space/manus-storage/bundle_fullritual_noprice_2c0ab63f.png', price: '$119', compare: '$149.94', savings: 'Most Popular' %}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Bundles",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Build your 30-day ritual." },
    { "type": "text", "id": "subhead", "label": "Subheadline", "default": "Bundle formulas by daypart and keep your ritual stocked." },
    { "type": "collection", "id": "collection", "label": "Bundles collection" }
  ],
  "presets": [{ "name": "Bundles" }]
}
{% endschema %}

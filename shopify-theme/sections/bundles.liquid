{% comment %}
  Section: bundles
  Ported from: Home.tsx §10 BUNDLES
  Design: Warm Editorial — horizontal snap carousel, subscribe toggle, ATC
{% endcomment %}
<section class="bundles" aria-label="Bundles">
  <div class="container">
    <h2 class="section-title">{{ section.settings.heading | default: 'Build Your Ritual Bundle' | escape }}</h2>
    <p class="section-subhead">{{ section.settings.subhead | escape }}</p>

    <div class="bundles-carousel" role="list">
      {%- for product in collections[section.settings.collection].products -%}
        {%- assign selling_plan = product.selling_plan_groups.first.selling_plans.first -%}
        <div class="bundle-card" role="listitem">
          <a href="{{ product.url }}" class="bundle-card__image-link" tabindex="-1" aria-hidden="true">
            <img
              src="{{ product.featured_image | image_url: width: 400 }}"
              alt="{{ product.featured_image.alt | default: product.title | escape }}"
              class="bundle-card__image"
              width="400"
              loading="lazy"
            >
          </a>
          <div class="bundle-card__body">
            <h3 class="bundle-card__title"><a href="{{ product.url }}">{{ product.title | escape }}</a></h3>
            <p class="bundle-card__tagline">{{ product.metafields.custom.tagline | escape }}</p>
            <div class="bundle-card__price">
              <span class="bundle-card__price-current">{{ product.price | money }}</span>
              {%- if selling_plan -%}
                <span class="bundle-card__price-subscribe">{{ product.price | times: 0.85 | round | money }} / mo</span>
              {%- endif -%}
            </div>
            <form action="/cart/add" method="post" class="bundle-card__atc-form">
              <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
              <button type="submit" class="btn btn--primary btn--full">Add Bundle to Cart</button>
            </form>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Bundles",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Build Your Ritual Bundle" },
    { "type": "text", "id": "subhead", "label": "Subheadline" },
    { "type": "collection", "id": "collection", "label": "Bundles collection" }
  ],
  "presets": [{ "name": "Bundles" }]
}
{% endschema %}

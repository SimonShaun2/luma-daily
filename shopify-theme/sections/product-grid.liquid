{% comment %}
  Section: product-grid
  Ported from: Home.tsx §7 PRODUCTS
  Design: Warm Editorial — filter tabs, horizontal snap carousel, subscribe toggle, ATC button
  Requires: Recharge selling plans on each product for subscribe pricing
{% endcomment %}

<section class="product-grid" id="products" aria-label="Products">
  <div class="container">
    <h2 class="section-title">{{ section.settings.heading | default: 'Choose Your Formula' | escape }}</h2>
    <p class="section-subhead">{{ section.settings.subhead | escape }}</p>

    {%- comment -%} Filter tabs — driven by product tags {%- endcomment -%}
    <div class="product-filter-tabs" role="tablist" aria-label="Filter by formula">
      <button class="filter-tab filter-tab--active" data-filter="all" role="tab" aria-selected="true">All</button>
      {%- assign filter_tags = section.settings.filter_tags | split: ',' -%}
      {%- for tag in filter_tags -%}
        <button class="filter-tab" data-filter="{{ tag | strip | handle }}" role="tab" aria-selected="false">
          {{ tag | strip | escape }}
        </button>
      {%- endfor -%}
    </div>

    {%- comment -%} Product carousel {%- endcomment -%}
    <div class="product-carousel" role="list">
      {%- for product in collections[section.settings.collection].products -%}
        {%- assign selling_plan = product.selling_plan_groups.first.selling_plans.first -%}
        {%- assign subscribe_price = product.price | times: 0.85 | round -%}

        <div class="product-card" data-tags="{{ product.tags | join: ',' | downcase }}" role="listitem">
          <a href="{{ product.url }}" class="product-card__image-link" tabindex="-1" aria-hidden="true">
            <img
              src="{{ product.featured_image | image_url: width: 400 }}"
              alt="{{ product.featured_image.alt | default: product.title | escape }}"
              class="product-card__image"
              width="400"
              height="400"
              loading="lazy"
            >
          </a>

          <div class="product-card__body">
            <div class="product-card__flavor-badge">{{ product.metafields.custom.flavor | escape }}</div>
            <h3 class="product-card__title">
              <a href="{{ product.url }}">{{ product.title | escape }}</a>
            </h3>
            <div class="product-card__stars" aria-label="{{ product.metafields.reviews.rating | default: '4.9' }} stars">★★★★★</div>
            <p class="product-card__tagline">{{ product.metafields.custom.tagline | escape }}</p>

            {%- comment -%} Subscribe toggle {%- endcomment -%}
            <div class="product-card__purchase-toggle">
              <label class="toggle-option toggle-option--active" data-mode="one-time">
                <input type="radio" name="purchase-mode-{{ product.id }}" value="one-time" checked>
                One-time <strong>{{ product.price | money }}</strong>
              </label>
              {%- if selling_plan -%}
                <label class="toggle-option" data-mode="subscribe">
                  <input type="radio" name="purchase-mode-{{ product.id }}" value="subscribe">
                  Subscribe <strong>{{ subscribe_price | money }}</strong>
                  <span class="toggle-option__badge">Save 15%</span>
                </label>
              {%- endif -%}
            </div>

            <div class="product-card__actions">
              <form action="/cart/add" method="post" class="product-card__atc-form">
                <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                {%- if selling_plan -%}
                  <input type="hidden" name="selling_plan" value="{{ selling_plan.id }}" class="selling-plan-input" disabled>
                {%- endif -%}
                <button type="submit" class="btn btn--primary btn--full product-card__atc-btn" data-product-id="{{ product.id }}">
                  Add to Cart
                </button>
              </form>
              <a href="{{ product.url }}" class="btn btn--ghost btn--full product-card__details-btn">View Details</a>
            </div>
          </div>
        </div>
      {%- endfor -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Product Grid",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Section heading", "default": "Choose Your Formula" },
    { "type": "text", "id": "subhead", "label": "Section subheadline" },
    { "type": "collection", "id": "collection", "label": "Product collection" },
    { "type": "text", "id": "filter_tags", "label": "Filter tab tags (comma-separated)", "default": "Energy, Calm, Sleep, Focus, Glow, Gut", "info": "Must match product tags in Shopify Admin exactly." }
  ],
  "presets": [{ "name": "Product Grid" }]
}
{% endschema %}

{% comment %}Compact credibility strip. Uses block names when configured; otherwise Luma trust copy.{% endcomment %}

<section class="press-logos" aria-label="Credibility highlights">
  <div class="container">
    <p class="press-logos__label">{{ section.settings.label | default: 'Why customers start with Luma' | escape }}</p>
    <div class="press-logos__marquee" aria-hidden="true">
      <div class="press-logos__track">
        {%- if section.blocks.size > 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'logo' -%}
              <span class="press-logos__name" {{ block.shopify_attributes }}>{{ block.settings.name | escape }}</span>
            {%- endif -%}
          {%- endfor -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'logo' -%}
              <span class="press-logos__name" aria-hidden="true">{{ block.settings.name | escape }}</span>
            {%- endif -%}
          {%- endfor -%}
        {%- else -%}
          {%- assign items = '10,000+ daily rituals started;Third-party tested every batch;No artificial colors or flavors;Vegan and gluten-free;30-day satisfaction guarantee;Free shipping $50+' | split: ';' -%}
          {%- for item in items -%}<span class="press-logos__name">{{ item | escape }}</span>{%- endfor -%}
          {%- for item in items -%}<span class="press-logos__name" aria-hidden="true">{{ item | escape }}</span>{%- endfor -%}
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Press Logos",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "label", "label": "Label text", "default": "Why customers start with Luma" }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Press Mention",
      "settings": [
        { "type": "text", "id": "name", "label": "Publication name" }
      ]
    }
  ],
  "presets": [{ "name": "Press Logos" }]
}
{% endschema %}

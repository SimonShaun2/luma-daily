{% comment %}
  Section: header
  Design: Warm Editorial — sticky frosted-glass bar, Playfair logo, DM Sans nav links,
          amber cart badge, mobile hamburger
  Renders: {% section 'header' %} in layout/theme.liquid
{% endcomment %}

<header class="site-header" role="banner">
  <div class="container site-header__inner">

    {%- comment -%} Logo {%- endcomment -%}
    <a href="/" class="site-header__logo" aria-label="{{ shop.name }} home">
      {%- if section.settings.logo != blank -%}
        <img
          src="{{ section.settings.logo | image_url: width: 160, height: 40 }}"
          alt="{{ shop.name }}"
          width="160"
          height="40"
          loading="eager"
        >
      {%- else -%}
        {{ section.settings.logo_text | default: shop.name | escape }}
      {%- endif -%}
    </a>

    {%- comment -%} Desktop navigation {%- endcomment -%}
    <nav class="site-header__nav hide-mobile" aria-label="Main navigation">
      <a href="/#products">Shop All</a>
      <a href="/#bundles">Bundles</a>
      <a href="/#quiz">Find My Ritual</a>
      <a href="/#faq">FAQ</a>
      <a href="/pages/about">About</a>
    </nav>

    {%- comment -%} Actions: account + cart {%- endcomment -%}
    <div class="site-header__actions">

      {%- comment -%} Account link {%- endcomment -%}
      {%- if shop.customer_accounts_enabled -%}
        <a
          href="{%- if customer -%}/account{%- else -%}/account/login{%- endif -%}"
          class="site-header__account-btn"
          aria-label="{%- if customer -%}My account{%- else -%}Sign in{%- endif -%}"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
            <circle cx="12" cy="7" r="4"/>
          </svg>
        </a>
      {%- endif -%}

      {%- comment -%} Cart trigger {%- endcomment -%}
      <button
        class="site-header__cart-btn"
        data-cart-trigger
        aria-label="Open cart, {{ cart.item_count }} items"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
          <line x1="3" y1="6" x2="21" y2="6"/>
          <path d="M16 10a4 4 0 0 1-8 0"/>
        </svg>
        <span class="cart-badge" data-cart-count aria-live="polite">{{ cart.item_count }}</span>
      </button>

      {%- comment -%} Mobile hamburger {%- endcomment -%}
      <button
        class="site-header__hamburger hide-desktop"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <line x1="3" y1="6" x2="21" y2="6"/>
          <line x1="3" y1="12" x2="21" y2="12"/>
          <line x1="3" y1="18" x2="21" y2="18"/>
        </svg>
      </button>
    </div>
  </div>

  {%- comment -%} Mobile navigation drawer {%- endcomment -%}
  <nav
    id="mobile-nav"
    class="site-header__mobile-nav"
    aria-label="Mobile navigation"
    hidden
  >
    <div class="container site-header__mobile-nav-inner">
      <a href="/#products" class="site-header__mobile-link">Shop All</a>
      <a href="/#bundles" class="site-header__mobile-link">Bundles</a>
      <a href="/#quiz" class="site-header__mobile-link">Find My Ritual</a>
      <a href="/#faq" class="site-header__mobile-link">FAQ</a>
      <a href="/pages/about" class="site-header__mobile-link">About</a>
    </div>
  </nav>
</header>

<style>
  .site-header__mobile-nav {
    background: var(--color-cream);
    border-top: 1px solid var(--color-cream-dark);
  }
  .site-header__mobile-nav-inner {
    display: flex;
    flex-direction: column;
    padding: var(--space-4) 0;
  }
  .site-header__mobile-link {
    padding: var(--space-4) 0;
    font-size: 16px;
    font-weight: 500;
    color: var(--color-espresso);
    border-bottom: 1px solid var(--color-cream-dark);
  }
  .site-header__account-btn {
    color: var(--color-espresso);
    display: flex;
    align-items: center;
  }
</style>

<script>
(function() {
  var hamburger = document.querySelector('.site-header__hamburger');
  var mobileNav = document.getElementById('mobile-nav');
  if (!hamburger || !mobileNav) return;
  hamburger.addEventListener('click', function() {
    var open = this.getAttribute('aria-expanded') === 'true';
    this.setAttribute('aria-expanded', String(!open));
    mobileNav.hidden = open;
  });
})();
</script>

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo image" },
    { "type": "text", "id": "logo_text", "label": "Logo text (if no image)", "default": "Luma Daily" },
    { "type": "link_list", "id": "menu", "label": "Navigation menu", "default": "main-menu" }
  ]
}
{% endschema %}

{% comment %}
  Product grid with Luma-safe fallbacks.
  Shopify collection products render first; fallback cards keep connected previews conversion-ready.
{% endcomment %}

<section class="product-grid" id="products" aria-label="Products">
  <div class="container">
    <div class="luma-section-kicker">Choose your daily support</div>
    <h2 class="section-title">{{ section.settings.heading | default: 'Five formulas. One daily ritual.' | escape }}</h2>
    <p class="section-subhead">{{ section.settings.subhead | default: 'Subscribe and save 20% - cancel or adjust your cadence anytime.' | escape }}</p>

    <div class="product-filter-tabs" role="tablist" aria-label="Filter by formula">
      <button class="filter-tab filter-tab--active" data-filter="all" role="tab" aria-selected="true">All</button>
      {%- assign filter_tags = section.settings.filter_tags | split: ',' -%}
      {%- for tag in filter_tags -%}
        <button class="filter-tab" data-filter="{{ tag | strip | handle }}" role="tab" aria-selected="false">
          {{ tag | strip | escape }}
        </button>
      {%- endfor -%}
    </div>

    <div class="product-carousel" role="list">
      {%- assign selected_collection = collections[section.settings.collection] -%}
      {%- if selected_collection != blank and selected_collection.products_count > 0 -%}
        {%- for product in selected_collection.products -%}
          {%- assign selling_plan = product.selling_plan_groups.first.selling_plans.first -%}
          {%- assign subscribe_price = product.price | times: 0.8 | round -%}

          <div class="product-card" data-tags="{{ product.tags | join: ',' | downcase }}" role="listitem">
            <a href="{{ product.url }}" class="product-card__image-link" tabindex="-1" aria-hidden="true">
              <img
                src="{{ product.featured_image | image_url: width: 500 }}"
                alt="{{ product.featured_image.alt | default: product.title | escape }}"
                class="product-card__image"
                width="500"
                height="500"
                loading="lazy"
              >
            </a>

            <div class="product-card__body">
              <div class="product-card__time">{{ product.metafields.custom.usage_time | default: 'Daily' | escape }}</div>
              <div class="product-card__rating" aria-label="4.9 out of 5 stars">
                <span>&#9733;&#9733;&#9733;&#9733;&#9733;</span>
                <span>{{ product.metafields.custom.review_count | default: '1,240' }}</span>
              </div>
              <h3 class="product-card__title">
                <a href="{{ product.url }}">{{ product.title | escape }}</a>
              </h3>
              <p class="product-card__tagline">{{ product.metafields.custom.benefit | default: product.metafields.custom.tagline | default: 'Supports a consistent daily wellness ritual.' | escape }}</p>
              <p class="product-card__flavor">{{ product.metafields.custom.flavor | default: 'Fruit-forward flavor' | escape }} + more</p>

              <div class="product-card__purchase-toggle">
                <label class="toggle-option toggle-option--active" data-mode="subscribe">
                  <input type="radio" name="purchase-mode-{{ product.id }}" value="subscribe" checked>
                  <strong>{{ subscribe_price | money }}/mo</strong>
                  <span class="toggle-option__badge">Save 20%</span>
                </label>
                <span class="product-card__one-time">Or {{ product.price | money }} one-time</span>
              </div>

              <div class="product-card__actions">
                <form action="{{ routes.cart_add_url }}" method="post" class="product-card__atc-form">
                  <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                  {%- if selling_plan -%}
                    <input type="hidden" name="selling_plan" value="{{ selling_plan.id }}" class="selling-plan-input" disabled>
                  {%- endif -%}
                  <button type="submit" class="btn btn--primary btn--full product-card__atc-btn" data-product-id="{{ product.id }}">
                    Subscribe &amp; Save
                  </button>
                </form>
                <a href="{{ product.url }}" class="btn btn--ghost btn--full product-card__details-btn">+ Add to Ritual</a>
              </div>
            </div>
          </div>
        {%- endfor -%}
      {%- else -%}
        {%- assign fallback_products = 'Morning|Luma Energy|Supports energy + focus* as part of your daily routine.|Blood Orange Mango|22.40|28|luma-energy|luma-energy-blood-orange-mango-gummies.png|energy, morning;Anytime|Luma Calm|Supports calm + stress balance* throughout the day.|Raspberry Hibiscus|24.00|30|luma-calm|luma-calm-raspberry-hibiscus-gummies.png|calm, anytime;Evening|Luma Sleep|Supports restful sleep* and a consistent bedtime ritual.|Blueberry Lavender|25.60|32|luma-sleep|luma-sleep-blueberry-lavender-gummies.png|sleep, evening;Daily|Luma Glow|Supports healthy skin, hair + nails*.|Strawberry Peach|27.20|34|luma-glow|luma-glow-strawberry-peach-gummies.png|glow, daily;Daily|Luma Gut|Supports digestive wellness* and daily balance.|Citrus Mint|24.00|30|luma-gut|luma-gut-citrus-mint-gummies.png|gut, daily' | split: ';' -%}
        {%- for item in fallback_products -%}
          {%- assign product_data = item | split: '|' -%}
          {%- assign product_handle = product_data[6] -%}
          {%- assign image_asset = product_data[7] -%}
          {%- assign shop_product = all_products[product_handle] -%}
          <div class="product-card" data-tags="{{ product_data[8] | escape }}" role="listitem">
            <a href="{% if shop_product != blank %}{{ shop_product.url }}{% else %}/products/{{ product_handle }}{% endif %}" class="product-card__image-link" tabindex="-1" aria-hidden="true">
              {%- if shop_product != blank and shop_product.featured_image != blank -%}
                <img src="{{ shop_product.featured_image | image_url: width: 500 }}" alt="{{ shop_product.featured_image.alt | default: shop_product.title | escape }}" class="product-card__image" width="500" height="500" loading="lazy">
              {%- else -%}
                <img src="{{ image_asset | asset_url }}" alt="{{ product_data[1] | escape }} gummies" class="product-card__image" width="500" height="500" loading="lazy">
              {%- endif -%}
            </a>
            <div class="product-card__body">
              <div class="product-card__time">{{ product_data[0] | escape }}</div>
              <div class="product-card__rating" aria-label="4.9 out of 5 stars">
                <span>&#9733;&#9733;&#9733;&#9733;&#9733;</span>
                <span>1,240</span>
              </div>
              <h3 class="product-card__title">
                <a href="{% if shop_product != blank %}{{ shop_product.url }}{% else %}/products/{{ product_handle }}{% endif %}">{{ product_data[1] | escape }}</a>
              </h3>
              <p class="product-card__tagline">{{ product_data[2] | escape }}</p>
              <p class="product-card__flavor">{{ product_data[3] | escape }} + more</p>
              <div class="product-card__purchase-toggle">
                <label class="toggle-option toggle-option--active">
                  <input type="radio" checked>
                  <strong>${{ product_data[4] }}/mo</strong>
                  <span class="toggle-option__badge">Save 20%</span>
                </label>
                <span class="product-card__one-time">Or ${{ product_data[5] }} one-time</span>
              </div>
              <div class="product-card__actions">
                {%- if shop_product != blank and shop_product.selected_or_first_available_variant != blank -%}
                  <form action="{{ routes.cart_add_url }}" method="post" class="product-card__atc-form">
                    <input type="hidden" name="id" value="{{ shop_product.selected_or_first_available_variant.id }}">
                    <button type="submit" class="btn btn--primary btn--full product-card__atc-btn">Subscribe &amp; Save</button>
                  </form>
                {%- else -%}
                  <a href="/products/{{ product_handle }}" class="btn btn--primary btn--full product-card__atc-btn">Subscribe &amp; Save</a>
                {%- endif -%}
                <a href="/#quiz" class="btn btn--ghost btn--full product-card__details-btn">+ Add to Ritual</a>
              </div>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product Grid",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Section heading", "default": "Five formulas. One daily ritual." },
    { "type": "text", "id": "subhead", "label": "Section subheadline", "default": "Subscribe and save 20% - cancel or adjust your cadence anytime." },
    { "type": "collection", "id": "collection", "label": "Product collection" },
    { "type": "text", "id": "filter_tags", "label": "Filter tab tags (comma-separated)", "default": "Energy, Calm, Sleep, Glow, Gut", "info": "Must match product tags in Shopify Admin exactly." }
  ],
  "presets": [{ "name": "Product Grid" }]
}
{% endschema %}

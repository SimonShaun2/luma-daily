{% comment %}Homepage quiz CTA, not the full quiz. Links to the Shopify quiz page when created.{% endcomment %}

<section class="quiz-cta" id="quiz" aria-label="Find My Ritual quiz">
  <div class="container quiz-cta__inner">
    <div class="quiz-cta__copy">
      <div class="luma-section-kicker luma-section-kicker--dark">Not sure where to start?</div>
      <h2>{{ section.settings.heading | default: "Take 60 seconds. We'll build your ritual." | escape }}</h2>
      <p>{{ section.settings.subhead | default: 'Answer four quick questions and get a personalized daily ritual matched to your wellness goals.' | escape }}</p>
      <div class="quiz-cta__steps" aria-label="Quiz steps">
        <span><strong>1</strong>Your goals</span>
        <span><strong>2</strong>Your schedule</span>
        <span><strong>3</strong>More support</span>
        <span><strong>4</strong>Your ritual</span>
      </div>
      <a href="{{ section.settings.quiz_url | default: '/#products' }}" class="btn btn--primary btn--lg">
        {{ section.settings.cta_label | default: "Take the quiz - it's free" | escape }}
      </a>
    </div>
    <div class="quiz-cta__image">
      {%- if section.settings.image != blank -%}
        <img src="{{ section.settings.image | image_url: width: 560 }}" alt="{{ section.settings.image.alt | default: 'Luma Daily ritual quiz' | escape }}" width="560" height="560" loading="lazy">
      {%- else -%}
        <img src="{{ 'luma-daily-3-ritual-bundle.png' | asset_url }}" alt="Luma Daily recommended ritual bundle" width="560" height="560" loading="lazy">
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Quiz CTA",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Take 60 seconds. We'll build your ritual." },
    { "type": "text", "id": "subhead", "label": "Subheadline", "default": "Answer four quick questions and get a personalized daily ritual matched to your wellness goals." },
    { "type": "text", "id": "cta_label", "label": "CTA label", "default": "Take the quiz - it's free" },
    { "type": "url", "id": "quiz_url", "label": "Quiz URL" },
    { "type": "image_picker", "id": "image", "label": "Image" }
  ],
  "presets": [{ "name": "Quiz CTA" }]
}
{% endschema %}

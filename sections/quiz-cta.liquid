{% comment %}
  Section: quiz-cta
  Ported from: Home.tsx §8 QUIZ CTA
{% endcomment %}
<section class="quiz-cta" aria-label="Find My Ritual quiz">
  <div class="container quiz-cta__inner">
    <div class="quiz-cta__copy">
      <h2>{{ section.settings.heading | escape }}</h2>
      <p>{{ section.settings.subhead | escape }}</p>
      <a href="{{ section.settings.quiz_url | default: '/pages/quiz' }}" class="btn btn--primary btn--lg">
        {{ section.settings.cta_label | default: 'Find My Ritual' | escape }}
      </a>
    </div>
    {%- if section.settings.image != blank -%}
      <div class="quiz-cta__image">
        <img src="{{ section.settings.image | image_url: width: 500 }}" alt="{{ section.settings.image.alt | escape }}" width="500" height="500" loading="lazy">
      </div>
    {%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "Quiz CTA",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Not Sure Where to Start?" },
    { "type": "text", "id": "subhead", "label": "Subheadline", "default": "Take our 60-second quiz and get a personalised ritual." },
    { "type": "text", "id": "cta_label", "label": "CTA label", "default": "Find My Ritual" },
    { "type": "url", "id": "quiz_url", "label": "Quiz URL" },
    { "type": "image_picker", "id": "image", "label": "Image" }
  ],
  "presets": [{ "name": "Quiz CTA" }]
}
{% endschema %}

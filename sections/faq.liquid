{% comment %}FAQ accordion with fallback questions for connected previews.{% endcomment %}

<section class="faq" id="faq" aria-label="Frequently asked questions">
  <div class="container faq__inner">
    <div class="luma-section-kicker">Support</div>
    <h2 class="section-title">{{ section.settings.heading | default: 'Frequently asked questions.' | escape }}</h2>
    <p class="section-subhead">Everything you want to know about Luma Daily, subscriptions, shipping, and daily rituals.</p>

    <div class="faq__list" itemscope itemtype="https://schema.org/FAQPage">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'faq_item' -%}
            <div class="faq__item" itemscope itemprop="mainEntity" itemtype="https://schema.org/Question" {{ block.shopify_attributes }}>
              <button class="faq__question" aria-expanded="false" aria-controls="faq-answer-{{ forloop.index }}" itemprop="name">
                {{ block.settings.question | escape }}
                <span class="faq__icon" aria-hidden="true">+</span>
              </button>
              <div class="faq__answer" id="faq-answer-{{ forloop.index }}" hidden itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
                <div itemprop="text">{{ block.settings.answer }}</div>
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      {%- else -%}
        {%- assign faqs = 'When should I take Luma Daily gummies?|Use each formula based on the ritual moment listed on the product page. Energy is designed for morning or early afternoon, Calm for anytime, Sleep for evening, and Glow/Gut for daily routines.;Can I take more than one formula together?|Yes. Luma is designed around stackable daily support, so customers can build a simple ritual with multiple formulas.;Are they vegan and gluten-free?|Yes, Luma Daily gummies are designed to be vegan and gluten-free, with no artificial colors.;Can I subscribe and cancel anytime?|Yes. Subscription messaging is prepared for Appstle or Recharge, and customers should be able to pause, skip, or cancel once the subscription app is connected.;Where are they made?|Final manufacturing details should be confirmed in Shopify product copy before launch.' | split: ';' -%}
        {%- for faq in faqs -%}
          {%- assign data = faq | split: '|' -%}
          <div class="faq__item" itemscope itemprop="mainEntity" itemtype="https://schema.org/Question">
            <button class="faq__question" aria-expanded="false" aria-controls="faq-answer-fallback-{{ forloop.index }}" itemprop="name">
              {{ data[0] | escape }}
              <span class="faq__icon" aria-hidden="true">+</span>
            </button>
            <div class="faq__answer" id="faq-answer-fallback-{{ forloop.index }}" hidden itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
              <div itemprop="text"><p>{{ data[1] | escape }}</p></div>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

<script>
(function() {
  document.querySelectorAll('.faq__question').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var expanded = this.getAttribute('aria-expanded') === 'true';
      var answer = document.getElementById(this.getAttribute('aria-controls'));
      this.setAttribute('aria-expanded', String(!expanded));
      this.querySelector('.faq__icon').textContent = expanded ? '+' : '-';
      if (answer) answer.hidden = expanded;
    });
  });
})();
</script>

{% schema %}
{
  "name": "FAQ",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Section heading", "default": "Frequently asked questions." }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "FAQ Item",
      "settings": [
        { "type": "text", "id": "question", "label": "Question" },
        { "type": "richtext", "id": "answer", "label": "Answer" }
      ]
    }
  ],
  "presets": [{ "name": "FAQ" }]
}
{% endschema %}

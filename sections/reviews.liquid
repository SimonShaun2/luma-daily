{% comment %}Social proof section. Okendo/Judge.me can replace blocks later.{% endcomment %}

<section class="reviews" id="reviews" aria-label="Customer reviews">
  <div class="container">
    <div class="reviews__header">
      <div>
        <div class="luma-section-kicker">Social proof</div>
        <h2 class="section-title">{{ section.settings.heading | default: 'Real rituals. Real results.' | escape }}</h2>
      </div>
      <div class="reviews__summary">
        <span class="reviews__overall-stars" aria-label="{{ section.settings.overall_rating | default: '4.9' }} out of 5">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
        <span class="reviews__overall-score">{{ section.settings.overall_rating | default: '4.9' }}</span>
        <span class="reviews__overall-count">{{ section.settings.review_count | default: '4,280 verified reviews' }}</span>
      </div>
    </div>

    <div class="reviews__grid">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'review' -%}
            <div class="review-card" {{ block.shopify_attributes }}>
              <div class="review-card__stars" aria-label="{{ block.settings.rating }} stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
              <p class="review-card__body">{{ block.settings.body | escape }}</p>
              <div class="review-card__author">
                <strong>{{ block.settings.name | escape }}</strong>
                {%- if block.settings.verified -%}<span class="review-card__verified">Verified subscriber</span>{%- endif -%}
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      {%- else -%}
        {%- assign reviews = 'Sarah M. - Austin, TX|I have tried a dozen supplement brands. Luma Daily is the only one I have stuck with for more than two weeks.;James T. - Denver, CO|The Sleep gummies are legitimately the first sleep supplement that actually worked for me. I wake up rested, not groggy.;Priya K. - San Francisco, CA|The full ritual bundle replaced my cabinet of bottles. Clean labels, real doses, and my routine finally feels simple.' | split: ';' -%}
        {%- for review in reviews -%}
          {%- assign data = review | split: '|' -%}
          <div class="review-card">
            <div class="review-card__stars" aria-label="5 out of 5 stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
            <p class="review-card__body">"{{ data[1] | escape }}"</p>
            <div class="review-card__author"><strong>{{ data[0] | escape }}</strong><span class="review-card__verified">Verified subscriber</span></div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Reviews",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Real rituals. Real results." },
    { "type": "text", "id": "overall_rating", "label": "Overall rating", "default": "4.9" },
    { "type": "text", "id": "review_count", "label": "Review count", "default": "4,280 verified reviews" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "range", "id": "rating", "label": "Rating", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "textarea", "id": "body", "label": "Review body" },
        { "type": "text", "id": "name", "label": "Reviewer name" },
        { "type": "checkbox", "id": "verified", "label": "Verified purchase", "default": true }
      ]
    }
  ],
  "presets": [{ "name": "Reviews" }]
}
{% endschema %}

{% comment %}
  Editorial homepage hero. Shopify image picker wins; Luma bundle image is the default.
{% endcomment %}

<section class="hero section-cream" aria-label="Hero">
  <div class="hero__inner container">
    <div class="hero__copy">
      <div class="hero__social-proof">
        <div class="hero__stars" aria-label="4.9 out of 5 stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
        <span class="hero__review-count">10,000+ daily rituals started - 4.9 average</span>
      </div>

      <h1 class="hero__headline">{{ section.settings.headline | default: 'The gummies that make wellness feel like a ritual.' | newline_to_br }}</h1>
      <p class="hero__subhead">{{ section.settings.subhead | default: 'Five clean, great-tasting supplement gummies for energy, calm, sleep, glow, and gut support. Built for people who want daily wellness to feel simple.' | escape }}</p>

      <div class="hero__price-card">
        <strong>{{ section.settings.price_anchor | default: 'Starting at $22.40/mo' | escape }}</strong>
        <span>Subscribe &amp; save 20% - cancel anytime</span>
        <em>Save 20%</em>
      </div>

      <div class="hero__ctas">
        <a href="{{ section.settings.primary_cta_url | default: '/#quiz' }}" class="btn btn--primary btn--lg">
          {{ section.settings.primary_cta_label | default: 'Build My Ritual' | escape }}
        </a>
        <a href="{{ section.settings.secondary_cta_url | default: routes.all_products_collection_url }}" class="btn btn--ghost btn--lg">
          {{ section.settings.secondary_cta_label | default: 'Shop Best Sellers' | escape }}
        </a>
      </div>

      <div class="hero__trust-pills">
        <span class="trust-pill">Vegan &amp; gluten-free</span>
        <span class="trust-pill">Third-party tested</span>
        <span class="trust-pill">No artificial colors</span>
        <span class="trust-pill">30-day guarantee</span>
      </div>
    </div>

    <div class="hero__media">
      {%- if section.settings.hero_image != blank -%}
        <img
          src="{{ section.settings.hero_image | image_url: width: 760 }}"
          alt="{{ section.settings.hero_image.alt | default: 'Luma Daily gummies' | escape }}"
          class="hero__image"
          width="760"
          height="760"
          loading="eager"
        >
      {%- else -%}
        <img
          src="{{ 'luma-full-ritual-bundle.png' | asset_url }}"
          alt="Five Luma Daily gummy supplement bottles"
          class="hero__image"
          width="760"
          height="760"
          loading="eager"
        >
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "tag": "section",
  "settings": [
    { "type": "textarea", "id": "headline", "label": "Headline", "default": "The gummies that make wellness feel like a ritual." },
    { "type": "text", "id": "subhead", "label": "Subheadline", "default": "Five clean, great-tasting supplement gummies for energy, calm, sleep, glow, and gut support. Built for people who want daily wellness to feel simple." },
    { "type": "text", "id": "price_anchor", "label": "Price anchor", "default": "Starting at $22.40/mo" },
    { "type": "text", "id": "primary_cta_label", "label": "Primary CTA label", "default": "Build My Ritual" },
    { "type": "url", "id": "primary_cta_url", "label": "Primary CTA URL" },
    { "type": "text", "id": "secondary_cta_label", "label": "Secondary CTA label", "default": "Shop Best Sellers" },
    { "type": "url", "id": "secondary_cta_url", "label": "Secondary CTA URL" },
    { "type": "image_picker", "id": "hero_image", "label": "Hero image" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}

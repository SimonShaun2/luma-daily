{% comment %}Visual image strip. Blocks can later be replaced by UGC video thumbnails.{% endcomment %}

<section class="ugc-carousel" aria-label="Luma Daily product imagery">
  <div class="container">
    <div class="luma-section-kicker">See it in action</div>
    <h2 class="section-title">{{ section.settings.heading | default: 'A ritual that looks as good as it tastes.' | escape }}</h2>
    <div class="ugc-carousel__track" role="list">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'video' -%}
            <div class="ugc-carousel__item" role="listitem" {{ block.shopify_attributes }}>
              {%- if block.settings.thumbnail != blank -%}
                <img src="{{ block.settings.thumbnail | image_url: width: 360 }}" alt="{{ block.settings.alt | escape }}" width="360" height="360" loading="lazy" class="ugc-carousel__thumbnail">
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      {%- else -%}
        {%- assign images = 'luma-energy-blood-orange-mango-gummies.png|Luma Energy;luma-calm-raspberry-hibiscus-gummies.png|Luma Calm;luma-sleep-blueberry-lavender-gummies.png|Luma Sleep;luma-glow-strawberry-peach-gummies.png|Luma Glow;luma-gut-citrus-mint-gummies.png|Luma Gut' | split: ';' -%}
        {%- for item in images -%}
          {%- assign data = item | split: '|' -%}
          <div class="ugc-carousel__item" role="listitem">
            <img src="{{ data[0] | asset_url }}" alt="{{ data[1] | escape }} gummies" width="360" height="360" loading="lazy" class="ugc-carousel__thumbnail">
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "UGC Carousel",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "A ritual that looks as good as it tastes." }
  ],
  "blocks": [
    {
      "type": "video",
      "name": "Video or image",
      "settings": [
        { "type": "image_picker", "id": "thumbnail", "label": "Thumbnail image" },
        { "type": "text", "id": "alt", "label": "Alt text" },
        { "type": "url", "id": "video_url", "label": "Video URL" }
      ]
    }
  ],
  "presets": [{ "name": "UGC Carousel" }]
}
{% endschema %}

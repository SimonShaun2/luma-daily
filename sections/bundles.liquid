{% comment %}
  Bundle cards with Shopify product support and fallback bundle imagery.
{% endcomment %}

<section class="bundles" id="bundles" aria-label="Bundles">
  <div class="container">
    <div class="luma-section-kicker">Best value</div>
    <h2 class="section-title">{{ section.settings.heading | default: 'Build your 30-day wellness ritual.' | escape }}</h2>
    <p class="section-subhead">{{ section.settings.subhead | default: 'Bundle 2+ formulas and unlock tiered savings - up to 30% off the full ritual.' | escape }}</p>

    <div class="bundle-tier-pills" aria-label="Bundle savings tiers">
      <span>2 products <small>Save 10%</small></span>
      <span>3 products <small>Save 25%</small></span>
      <span class="bundle-tier-pills__active">All 5 products <small>Save 30% - Best</small></span>
    </div>

    <div class="bundles-carousel" role="list">
      {%- assign selected_collection = collections[section.settings.collection] -%}
      {%- if selected_collection != blank and selected_collection.products_count > 0 -%}
        {%- for product in selected_collection.products -%}
          {%- assign selling_plan = product.selling_plan_groups.first.selling_plans.first -%}
          <div class="bundle-card" role="listitem">
            <a href="{{ product.url }}" class="bundle-card__image-link" tabindex="-1" aria-hidden="true">
              <img
                src="{{ product.featured_image | image_url: width: 560 }}"
                alt="{{ product.featured_image.alt | default: product.title | escape }}"
                class="bundle-card__image"
                width="560"
                height="420"
                loading="lazy"
              >
            </a>
            <div class="bundle-card__body">
              <h3 class="bundle-card__title"><a href="{{ product.url }}">{{ product.title | escape }}</a></h3>
              <p class="bundle-card__tagline">{{ product.metafields.custom.tagline | default: 'Supports a consistent daily wellness ritual.' | escape }}</p>
              <div class="bundle-card__price">
                <span class="bundle-card__price-current">{{ product.price | times: 0.75 | round | money }}</span>
                <span class="bundle-card__price-subscribe">{{ product.price | money }} one-time</span>
              </div>
              <form action="{{ routes.cart_add_url }}" method="post" class="bundle-card__atc-form">
                <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                {%- if selling_plan -%}
                  <input type="hidden" name="selling_plan" value="{{ selling_plan.id }}" disabled>
                {%- endif -%}
                <button type="submit" class="btn btn--primary btn--full">Subscribe &amp; Save</button>
              </form>
            </div>
          </div>
        {%- endfor -%}
      {%- else -%}
        {%- assign fallback_bundles = 'The Morning + Evening Set|Energy by day, sleep support at night.|Luma Energy,Luma Sleep|50.40|56|Save 10%|luma-morning-evening-bundle.png|luma-energy;The Daily 3 Ritual|Energy, calm, and glow - every day.|Luma Energy,Luma Calm,Luma Glow|63|84|Save 25%|luma-daily-3-ritual-bundle.png|luma-energy;The Full Ritual|All five formulas for complete daily support.|Energy,Calm,Sleep,Glow,Gut|98|140|Save 30%|luma-full-ritual-bundle.png|luma-energy' | split: ';' -%}
        {%- for item in fallback_bundles -%}
          {%- assign bundle = item | split: '|' -%}
          {%- assign first_handle = bundle[7] -%}
          {%- assign first_product = all_products[first_handle] -%}
          <div class="bundle-card{% if forloop.index == 2 %} bundle-card--featured{% endif %}" role="listitem">
            <a href="/#quiz" class="bundle-card__image-link" tabindex="-1" aria-hidden="true">
              <img src="{{ bundle[6] | asset_url }}" alt="{{ bundle[0] | escape }}" class="bundle-card__image" width="560" height="420" loading="lazy">
            </a>
            <div class="bundle-card__body">
              {%- if forloop.index == 2 -%}<span class="bundle-card__badge">Most popular</span>{%- endif -%}
              <h3 class="bundle-card__title"><a href="/#quiz">{{ bundle[0] | escape }}</a></h3>
              <p class="bundle-card__tagline">{{ bundle[1] | escape }}</p>
              <div class="bundle-card__chips">
                {%- assign chips = bundle[2] | split: ',' -%}
                {%- for chip in chips -%}
                  <span>{{ chip | strip | escape }}</span>
                {%- endfor -%}
              </div>
              <div class="bundle-card__price">
                <span class="bundle-card__price-current">${{ bundle[3] }}</span>
                <span class="bundle-card__price-subscribe"><s>${{ bundle[4] }}</s></span>
                <span class="toggle-option__badge">{{ bundle[5] | escape }}</span>
              </div>
              {%- if first_product != blank and first_product.selected_or_first_available_variant != blank -%}
                <form action="{{ routes.cart_add_url }}" method="post" class="bundle-card__atc-form">
                  <input type="hidden" name="id" value="{{ first_product.selected_or_first_available_variant.id }}">
                  <button type="submit" class="btn btn--primary btn--full">Subscribe &amp; Save</button>
                </form>
              {%- else -%}
                <a href="/#quiz" class="btn btn--primary btn--full">Subscribe &amp; Save</a>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Bundles",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Build your 30-day wellness ritual." },
    { "type": "text", "id": "subhead", "label": "Subheadline", "default": "Bundle 2+ formulas and unlock tiered savings - up to 30% off the full ritual." },
    { "type": "collection", "id": "collection", "label": "Bundles collection" }
  ],
  "presets": [{ "name": "Bundles" }]
}
{% endschema %}

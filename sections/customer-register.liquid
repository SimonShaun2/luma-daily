{% comment %}
  Section: customer-register
  Ported from: Home.tsx Register page
{% endcomment %}

<div class="customer-page">
  <div class="container customer-page__inner">
    <h1 class="customer-page__title">Create Account</h1>

    {%- form 'create_customer', id: 'customer-register-form' -%}
      {%- if form.errors -%}
        <div class="form-errors" role="alert">{{ form.errors | default_errors }}</div>
      {%- endif -%}

      <div style="display:grid; grid-template-columns:1fr 1fr; gap: var(--space-4);">
        <div class="form-group">
          <label class="form-label" for="reg-first-name">First name</label>
          <input type="text" id="reg-first-name" name="customer[first_name]" autocomplete="given-name" class="form-input" placeholder="Jane">
        </div>
        <div class="form-group">
          <label class="form-label" for="reg-last-name">Last name</label>
          <input type="text" id="reg-last-name" name="customer[last_name]" autocomplete="family-name" class="form-input" placeholder="Smith">
        </div>
      </div>

      <div class="form-group">
        <label class="form-label" for="reg-email">Email</label>
        <input type="email" id="reg-email" name="customer[email]" autocomplete="email" required class="form-input" placeholder="you@example.com">
      </div>

      <div class="form-group">
        <label class="form-label" for="reg-password">Password</label>
        <input type="password" id="reg-password" name="customer[password]" autocomplete="new-password" required minlength="5" class="form-input" placeholder="Min. 5 characters">
      </div>

      <button type="submit" class="btn btn--primary btn--full" style="margin-bottom: var(--space-4);">
        Create Account
      </button>

      <p style="text-align:center; font-size:14px;">
        Already have an account? <a href="/account/login" class="form-link">Sign in</a>
      </p>
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "Customer Register",
  "tag": "section",
  "settings": [],
  "presets": [{ "name": "Customer Register" }]
}
{% endschema %}
